    <property name="jdk.home" value="${JDK_HOME}"/>

    <target name="sanity-check-build">
        <fail message="Could not find the JDK!">
            <condition>
                <not>
                    <available file="${jdk.home}" type="dir"/>
                </not>
            </condition>
        </fail>
    </target>

    <target name="determine-jdk">
        <!-- Modern JDK detection (JDK 9+) -->
        <condition property="modern.jdk">
            <available classname="java.lang.Module"/>
        </condition>
        
        <!-- Set jdk14 property for both modern and legacy JDKs -->
        <available property="jdk14" classname="java.sql.Savepoint" ignoresystemclasses="true">
            <classpath>
                <pathelement location="${jdk.home}/jre/lib/rt.jar"/>
            </classpath>
        </available>
        
        <!-- For modern JDKs, set jdk14 property directly -->
        <condition property="jdk14">
            <isset property="modern.jdk"/>
        </condition>
        
        <!-- Log JDK detection results -->
        <echo message="JDK detection: modern.jdk=${modern.jdk}, jdk14=${jdk14}"/>
    </target>
